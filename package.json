{
  "name": "css-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:preview": "tsx --tsconfig tsconfig.app.json scripts/test-preview.ts",
    "vendor:tailwind": "node scripts/vendor-tailwind.mjs",
    "test:checks": "tsx --tsconfig tsconfig.app.json scripts/test-checks.ts",
    "test:content": "npm run build:content && tsx --tsconfig tsconfig.app.json scripts/test-content.ts",
    "test": "npm run test:css && npm run test:explain && npm run test:annotations && npm run test:preview && npm run test:checks && npm run test:progress && npm run test:quiz && npm run test:polish && npm run test:a11y && npm run test:render && npm run test:workspace && npm run test:seed && npm run test:content",
    "build:content": "tsx --tsconfig tsconfig.app.json scripts/build-content.ts && tsx --tsconfig tsconfig.app.json scripts/build-search-index.ts",
    "predev": "npm run build:content",
    "prebuild": "npm run build:content",
    "test:progress": "tsx --tsconfig tsconfig.app.json scripts/test-progress.ts",
    "test:css": "tsx --tsconfig tsconfig.app.json scripts/test-css.ts",
    "test:annotations": "tsx --tsconfig tsconfig.app.json scripts/test-annotations.ts",
    "test:explain": "tsx --tsconfig tsconfig.app.json scripts/test-explain.ts",
    "test:quiz": "tsx --tsconfig tsconfig.app.json scripts/test-quiz.ts",
    "test:polish": "tsx --tsconfig tsconfig.app.json scripts/test-polish.ts",
    "test:a11y": "tsx --tsconfig tsconfig.app.json scripts/test-a11y.ts",
    "test:render": "tsx --tsconfig tsconfig.app.json scripts/test-render.ts",
    "test:workspace": "tsx --tsconfig tsconfig.app.json scripts/test-workspace.ts",
    "content:status": "tsx --tsconfig tsconfig.app.json scripts/content-status.ts",
    "test:seed": "tsx --tsconfig tsconfig.app.json scripts/test-playground-seed.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tailwindcss/browser": "^4.3.3",
    "codemirror": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
